{
  "name": "news-hub",
  "description": "A simplified news reader for Gannet owned sites",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^1.2.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "eslint": "^10.13.0",
    "nuxt": "^4.6.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.4",
    "@types/node": "^26.6.6",
    "@vue/test-utils": "^2.5.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "happy-dom": "^21.0.4",
    "prettier": "^3.8.1",
    "vitest": "^5.1.0"
  }
}
